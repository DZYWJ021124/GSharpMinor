<!-- 文字抗锯齿用灰度（Grayscale），不用 ClearType：
     ClearType 靠 RGB 次像素做横向超采样，代价是每个字形边缘都带一圈橙/蓝彩边。
     宋体的 C、S 这类全曲线字符，每一像素列都在换次像素相位，彩边连成一片"锯齿"；
     而 N、D、I 的竖直笔画对齐像素栅格，反而干净——所以只有 C、S 看着脏。
     本机 4K@200%，15 DIP = 30 物理像素，横向分辨率早就够，灰度 AA 干净且无色边。 -->
<Window x:Class="Pa1.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pa1.App"
        Title="G# minor · Spectrum Analyzer" Height="820" Width="1180"
        MinHeight="620" MinWidth="900"
        Background="Transparent" AllowsTransparency="True" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="Win_StateChanged"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragOver="Win_DragOver" Drop="Win_Drop">
  <!-- 自绘窗口外观：无系统标题栏/边框；WindowChrome 保留原生缩放、贴边与最大化工作区行为。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- ══ 主题色板（UpdateThemeBrushes 换肤时整支换新实例，XAML 走 DynamicResource 自动重解析） ══ -->
    <SolidColorBrush x:Key="BgBrush" Color="#0b0d08"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#12140d"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#171a11"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2c2f24"/>
    <SolidColorBrush x:Key="TextBrush" Color="#e9e7dc"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8a887b"/>
    <SolidColorBrush x:Key="WinBtnBrush" Color="#b5b2a3"/>
    <SolidColorBrush x:Key="TopBarBrush" Color="#040503"/>
    <SolidColorBrush x:Key="PhosBrush" Color="#3dff85"/>
    <SolidColorBrush x:Key="PhosDimBrush" Color="#2ca35c"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#ffb340"/>
    <SolidColorBrush x:Key="TrackBgBrush" Color="#22241b"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1affff55"/>
    <SolidColorBrush x:Key="SelBrush" Color="#2e3dff85"/>

    <!-- ══ Skia 文本模板 ══
         窗口是分层窗口（保连续曲率外轮廓），分层窗口没有不透明底色，系统不给 ClearType，
         WPF 只能退化成不做次像素定位的灰度 AA，小字号笔画一列深一列浅。所有 UI 文字
         改由 SkiaText 按设备像素栅格化。

         按钮的 Content 仍是字符串（代码里 BtnPlay.Content = "▶ Play" 全部照旧），
         用 ContentTemplate 把字符串接到 SkiaText 上。

         字号/字重/颜色绑自身继承来的 TextElement.*（Control.Foreground/FontSize/FontWeight
         就是 TextElement 那三个附加属性的 AddOwner，值靠继承往下传）：
         · Button 上设 Foreground/FontSize，触发器改色 → 继承值变 → 绑定刷新 → 位图重建；
         · 表格行上设 Foreground（选中变磷光绿）→ 一路继承到单元格里的文字；
         · 下拉弹层是独立 Popup（另一棵可视树），RelativeSource AncestorType 上溯不过去，
           但继承值照样能传到 Popup.Child —— 所以只绑继承值，一处覆盖三种宿主。 -->
    <DataTemplate x:Key="SkiaCaption">
      <local:SkiaText Text="{Binding}"
                      FontSize="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}}"
                      FontWeight="{Binding Path=(TextElement.FontWeight), RelativeSource={RelativeSource Self}}"
                      Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </DataTemplate>

    <!-- ══ 页签 ══ -->
    <Style x:Key="TabBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="ContentTemplate" Value="{StaticResource SkiaCaption}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <local:SquircleBorder x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </local:SquircleBorder>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PhosBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 曲名字体（Pa1 Serif SC）不走 pack://：字库 22MB，构建期压缩、运行时解压，见 TitleFont.cs；
         曲名由 SkiaTitle 直接用解压后的 TTF 由 Skia 栅格化（WPF 同字号下 S/C 曲线台阶明显，
         且行高裁切会把 J 的下伸钩切掉）。 -->

    <!-- ══ 常规按钮 ══ -->
    <Style x:Key="TxtBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="ContentTemplate" Value="{StaticResource SkiaCaption}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <local:SquircleBorder x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </local:SquircleBorder>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PhosBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PhosBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource LineBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ══ 播放键（琥珀主操作） ══ -->
    <Style x:Key="PlayBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="24,9"/>
      <Setter Property="ContentTemplate" Value="{StaticResource SkiaCaption}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <local:SquircleBorder x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </local:SquircleBorder>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#33ffb340"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AmberBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#55ffb340"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ══ 主题字样（无边框，仅 Light/Dark 字样；颜色随主题联动） ══ -->
    <Style x:Key="ThemeTag" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource PhosBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="ContentTemplate" Value="{StaticResource SkiaCaption}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ══ 自绘窗口按钮（WinBtnBrush：Light 更深 / Dark 更浅） ══ -->
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource WinBtnBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- 窗口按钮不做键盘焦点目标：否则会画出系统虚线焦点框 -->
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <local:SquircleBorder x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </local:SquircleBorder>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PhosBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 窗口控制图标：三个图标同 10×10 画布、同物理像素线宽，由 Skia 栅格化。
         之前用 WPF Path（StrokeThickness=1.2 → 200% 下 2.4 物理像素）跨像素边界，
         抗锯齿把每根笔画糊成 3 列灰，最小化那根横线看着最细、关闭斜线看着最粗，
         所以"三个按钮大小不统一"。Skia 把线宽取整、轴对齐笔画吸附像素格后完全一致。 -->
    <Style x:Key="WinGlyphIcon" TargetType="local:SkiaIcon">
      <Setter Property="BoxSize" Value="10"/>
      <Setter Property="StrokeWidth" Value="1"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ══ 滚动条：细轨道 + Thumb，纵向/横向共用视觉语言 ══
         FixedThumbTrack：thumb 长度 = clamp(轨道长×视口/内容, 26, 轨道长)——
         最矮 26px、内容少按比例变长；ViewportSize 恒 NaN 走定长路径，
         槽位即 thumb 自身尺寸，任何长度都不会被布局裁剪成"上圆下平"。
         颜色：Light=CLIP 琥珀 / Dark=磷光绿（ScrollThumbBrush，随主题换肤）。 -->
    <Style x:Key="ScrollRepeat" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <!-- Light=CLIP 琥珀、Dark=磷光绿（ScrollThumbBrush，SetRes 随主题换肤） -->
            <Border x:Name="bd" Margin="2" CornerRadius="3"
                    Background="{DynamicResource ScrollThumbBrush}" Opacity="0.6"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.95"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <local:FixedThumbTrack x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollRepeat}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollRepeat}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <!-- 最矮 26px、内容少按比例变长（FixedThumbTrack.SyncThumb 写 Height） -->
                  <Thumb Style="{StaticResource ScrollThumb}" MinHeight="26"/>
                </Track.Thumb>
              </local:FixedThumbTrack>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="11"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                  <local:FixedThumbTrack x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource ScrollRepeat}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource ScrollRepeat}"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <!-- 最矮 26px、内容少按比例变长（与纵向同理） -->
                      <Thumb Style="{StaticResource ScrollThumb}" MinWidth="26"/>
                    </Track.Thumb>
                  </local:FixedThumbTrack>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ══ 音量滑条（磷光主题） ══ -->
    <Style x:Key="VolSlider" TargetType="Slider">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent" VerticalAlignment="Center">
              <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBgBrush}" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource PhosDimBrush}" VerticalAlignment="Center" Margin="0,0,0,0"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="15" Height="15">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="15" Height="15" Fill="{DynamicResource PhosBrush}"
                                 Stroke="{DynamicResource PanelBrush}" StrokeThickness="2.5"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ══ 输出设备下拉 ══ -->
    <Style x:Key="DevCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="ItemTemplate" Value="{StaticResource SkiaCaption}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="10,8">
                      <DockPanel>
                                <local:SkiaText DockPanel.Dock="Right" Text="▾" Foreground="{DynamicResource MutedBrush}"
                                                FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <ContentPresenter/>
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PhosBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{StaticResource SkiaCaption}"
                                Margin="11,8,30,8" VerticalAlignment="Center" HorizontalAlignment="Left"
                                TextElement.Foreground="{DynamicResource TextBrush}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="3" Margin="0,2,0,0" MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="280">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelBrush}"/>
                      <Setter Property="Foreground" Value="{DynamicResource PhosBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- 窗口壳：透明 HWND + 超椭圆背景容器（连续曲率圆角；最大化时 Win_StateChanged 置 0）。
       WinBg 作为根容器包裹全部内容：背景铺满整窗，内容在内层 Grid 三行布局。
       走分层窗口（AllowsTransparency=True）是为了让 squircle 外轮廓真正透明——
       DWM 的圆角只有圆形/直角两种，做不到连续曲率。 -->
  <local:SquircleBorder x:Name="WinBg" CornerRadius="10" Background="{DynamicResource BgBrush}">
  <Grid x:Name="RootBg">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ══ 顶部：第一排全出血背景带（贴窗口上/左/右缘，元素上下居中、靠右），第二排品牌/功能 ══ -->
    <Grid x:Name="TitleBar" Grid.Row="0"
          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
          MouseMove="TitleBar_MouseMove"
          MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 第一排：主题字样 + 窗口控制（背景带贴窗口上/左/右缘，上下居中、靠右） -->
      <local:SquircleBorder Grid.Row="0" Background="{DynamicResource TopBarBrush}" CornerRadius="10"
                            TopOnly="True" Padding="0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="BtnTheme" Content="Light" Click="BtnTheme_Click" Style="{StaticResource ThemeTag}"
                  Margin="0,0,16,0" ToolTip="切换主题（T 键）"/>
          <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource WinBtn}"
                  ToolTip="最小化">
            <local:SkiaIcon Style="{StaticResource WinGlyphIcon}" Kind="min"/>
          </Button>
          <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource WinBtn}"
                  ToolTip="最大化">
            <Grid Width="10" Height="10">
              <local:SkiaIcon x:Name="MaxGlyph" Style="{StaticResource WinGlyphIcon}" Kind="max"/>
              <local:SkiaIcon x:Name="RestoreGlyph" Style="{StaticResource WinGlyphIcon}" Kind="restore" Visibility="Collapsed"/>
            </Grid>
          </Button>
          <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource WinCloseBtn}"
                  ToolTip="关闭">
            <local:SkiaIcon Style="{StaticResource WinGlyphIcon}" Kind="close"/>
          </Button>
        </StackPanel>
      </local:SquircleBorder>

      <!-- 第二排：品牌 + 信号灯 / 页签（保持原内缩） -->
      <Grid Grid.Row="1" Margin="26,12,20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <local:SkiaBrand x:Name="BrandText" Grid.Column="0" VerticalAlignment="Center"
                         Foreground="{DynamicResource PhosBrush}"
                         GlowColor="#3dff85" GlowOpacity="0.5" GlowRadius="22">
          <!-- G# minor：Skia 自绘（G 36 / # 上标 24 / Italic+Bold），字号、字重、斜体、位置保持原样。
               辉光也由 Skia 画（模糊影子 + 清晰文字），不再用 DropShadowEffect——Effect 管线会把字糊掉。 -->
        </local:SkiaBrand>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
            <Ellipse x:Name="LedSignal" Width="9" Height="9" Fill="{DynamicResource TrackBgBrush}" Margin="0,0,7,0">
              <Ellipse.Effect>
                <DropShadowEffect x:Name="GlowSig" BlurRadius="10" ShadowDepth="0" Opacity="0" Color="#3dff85"/>
              </Ellipse.Effect>
            </Ellipse>
            <local:SkiaText Text="SIG" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                            VerticalAlignment="Center" FontWeight="Bold"/>
            <Ellipse x:Name="LedClip" Width="9" Height="9" Fill="{DynamicResource TrackBgBrush}" Margin="16,0,7,0">
              <Ellipse.Effect>
                <DropShadowEffect x:Name="GlowClip" BlurRadius="10" ShadowDepth="0" Opacity="0" Color="#ffb340"/>
              </Ellipse.Effect>
            </Ellipse>
            <local:SkiaText Text="CLIP" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                            VerticalAlignment="Center" FontWeight="Bold"/>
          </StackPanel>
          <Button x:Name="TabAnalyzer" Content="ANALYZER" Click="Tab_Click" Style="{StaticResource TabBtn}"/>
          <Button x:Name="TabLibrary" Content="LIBRARY" Click="Tab_Click" Style="{StaticResource TabBtn}"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="26,10,26,0"
            Background="{DynamicResource LineBrush}"/>

    <!-- ══ 页一：分析仪 ══ -->
    <Grid x:Name="PageA" Grid.Row="1" Margin="26,14,26,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 顶部导入操作区：独立成行，窗口变窄时不再与走带按钮互相挤压。 -->
      <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <local:SkiaText x:Name="LblSpectrum" Text="SPECTRUM / INPUT" FontSize="9.5" FontWeight="Bold"
                          Foreground="{DynamicResource PhosDimBrush}"/>
          <local:SkiaText Text="DRAG AUDIO ANYWHERE TO IMPORT" FontSize="8.5"
                          Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnAdd" Content="+ Add Files" Click="BtnAdd_Click" Style="{StaticResource TxtBtn}"/>
          <Button x:Name="BtnAddFolder" Content="+ Add Folder" Click="BtnAddFolder_Click"
                  Style="{StaticResource TxtBtn}" Margin="10,0,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- 频谱屏（细边框；不再挂 DropShadowEffect——大画布每帧离屏模糊会拖垮 Analyser 帧率并饿死音频线程）
           不设 MinHeight：任何固定下限都会在最小窗口高度（星号行槽位 ~167px < 200）下
           撑破槽位，被 WPF 布局裁掉画布底部——频率刻度整行消失。画布按槽位自适应绘制。 -->
      <local:SquircleBorder Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5"
              Background="{DynamicResource PanelBrush}" Padding="3">
        <local:SpectrumControl x:Name="SpecView"/>
      </local:SquircleBorder>

      <!-- 传输台卡片 -->
      <local:SquircleBorder Grid.Row="2" Margin="0,16,0,10" Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="22,18,22,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 曲目信息 + 进度 -->
          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <!-- 与曲库页同一套轮播：放得下静止，放不下原文+副本无缝滚动。
                     ClipToBounds 裁掉溢出，Canvas 保证副本不被列宽钳断。 -->
                <Grid x:Name="NpNameClipA" ClipToBounds="True" SizeChanged="NpNameClipA_SizeChanged">
                  <Canvas x:Name="NpNameRunA" HorizontalAlignment="Left" VerticalAlignment="Center"
                          UseLayoutRounding="False"
                          Height="{Binding ActualHeight, ElementName=NpName}">
                    <local:SkiaTitle x:Name="NpName" Text="— NO DISC —" FontSize="20" Foreground="{DynamicResource TextBrush}"/>
                    <local:SkiaTitle x:Name="NpNameCopy" Text="" FontSize="20" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed"/>
                    <Canvas.RenderTransform>
                      <TranslateTransform x:Name="NpNameShiftA" X="0"/>
                    </Canvas.RenderTransform>
                  </Canvas>
                </Grid>
                <local:SkiaText x:Name="NpSub" Text="G# minor · AWAITING SIGNAL"
                                FontSize="9.5" Foreground="{DynamicResource PhosDimBrush}" Margin="0,6,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <local:SkiaText x:Name="TimeNow" Text="0:00" FontSize="13"
                                Foreground="{DynamicResource PhosBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                <local:SkiaText Text=" / " FontSize="13"
                                Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <local:SkiaText x:Name="TimeTotal" Text="0:00" FontSize="13"
                                Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>

            <!-- 进度条：底槽 + 已播填充 + 游标。
                 MouseDown 捕获鼠标：拖出 22px 轨道后仍能收到 MouseUp——否则松手落在轨道外
                 时 seek 丢失且 _scrubbing 粘住（进度头冻结、音乐与进度条错位） -->
            <Grid x:Name="ScrubTrack" Height="22" Margin="0,12,0,0" Background="Transparent"
                  MouseLeftButtonDown="Scrub_MouseLeftButtonDown"
                  MouseLeftButtonUp="Scrub_MouseLeftButtonUp" MouseMove="Scrub_MouseMove"
                  LostMouseCapture="Scrub_LostMouseCapture" Cursor="Hand">
              <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center" Background="{DynamicResource TrackBgBrush}"/>
              <Rectangle x:Name="ScrubFill" Width="0" Height="5" RadiusX="2.5" RadiusY="2.5"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource PhosDimBrush}"/>
              <Line x:Name="ScrubHead" X1="0" Y1="2" X2="0" Y2="20" Stroke="{DynamicResource AmberBrush}"
                    StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
          </StackPanel>

          <!-- 走带按钮 -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="BtnPrev" Content="|◀ Prev" Click="BtnPrev_Click" Style="{StaticResource TxtBtn}"/>
            <Button x:Name="BtnPlay" Content="▶ Play" Click="BtnPlay_Click" Style="{StaticResource PlayBtn}" Margin="10,0,0,0"/>
            <Button x:Name="BtnNext" Content="Next ▶|" Click="BtnNext_Click" Style="{StaticResource TxtBtn}" Margin="10,0,0,0"/>
            <Button x:Name="BtnStop" Content="■ Stop" Click="BtnStop_Click" Style="{StaticResource TxtBtn}" Margin="10,0,0,0"/>
            <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="16,4,16,4"/>
            <Button x:Name="BtnMode" Content="Order" Click="BtnMode_Click" Style="{StaticResource TxtBtn}"
                    ToolTip="播放模式"/>
            <Button x:Name="BtnRange" Content="Range · -96dB" Click="BtnRange_Click" Style="{StaticResource TxtBtn}"
                    Margin="10,0,0,0" ToolTip="频谱量程下限（R 循环切换）"/>
            <Button x:Name="BtnNorm" Content="NORM · OFF" Click="BtnNorm_Click" Style="{StaticResource TxtBtn}"
                    Margin="10,0,0,0" ToolTip="响度归一化：目标 -18 LUFS（ReplayGain 标签优先，缺失自动扫描；N 键开关）"/>
          </StackPanel>

          <!-- 电平 / 音量 / 输出 -->
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
              <local:SkiaText Text="LEVEL" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                              FontWeight="Bold"/>
              <Grid x:Name="MeterTrack" Height="8" Background="{DynamicResource TrackBgBrush}" Margin="0,7,0,0"
                    VerticalAlignment="Center">
                <Rectangle x:Name="MeterFill" Width="0" RadiusX="4" RadiusY="4" Fill="{DynamicResource PhosBrush}"
                           HorizontalAlignment="Left"/>
              </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
              <local:SkiaText Text="VOL" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                              FontWeight="Bold"/>
              <Slider x:Name="VolSlider" Minimum="0" Maximum="100" Value="80" ValueChanged="Vol_ValueChanged"
                      Style="{StaticResource VolSlider}" Margin="0,5,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <local:SkiaText Text="OUTPUT DEVICE" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                              FontWeight="Bold"/>
              <DockPanel Margin="0,7,0,0">
                <Button x:Name="BtnExclusive" Content="Exclusive · OFF" Click="BtnExclusive_Click"
                        Style="{StaticResource TxtBtn}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <Button x:Name="BtnDsdOut" Content="DSD · DoP" Click="BtnDsdOut_Click"
                        Style="{StaticResource TxtBtn}" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,9"
                        ToolTip="DSD 输出模式：DoP / Native 位流 / PCM 软解（点击循环）"/>
                <ComboBox x:Name="DevCombo" SelectionChanged="DevCombo_SelectionChanged"
                          Style="{StaticResource DevCombo}"/>
              </DockPanel>
              <local:SkiaText x:Name="ChainReadout" Text="OUT · SHARED · —" FontSize="9.5"
                              Foreground="{DynamicResource PhosDimBrush}" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
        </Grid>
      </local:SquircleBorder>
    </Grid>

    <!-- ══ 页二：曲目管理 ══ -->
    <Grid x:Name="PageB" Grid.Row="1" Margin="26,14,26,0" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- NOW PLAYING 卡片 -->
      <local:SquircleBorder Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="1" CornerRadius="5" Padding="20,16" Margin="0,0,0,16">
        <!-- 两列 Grid（文字 * / 走带 Auto）：走带永远贴右且固定留位。
             原 DockPanel 有两个毛病：默认 LastChildFill=True 时最后一个子元素吃掉整片
             剩余空间（不管 Dock 在哪），横向 StackPanel 便从左排起 → 按钮贴着曲名；
             改成 LastChildFill=False 能靠右，但长曲名会把左侧宽度吃满、把按钮挤出可视区。 -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <local:SkiaText Text="NOW PLAYING" FontSize="8.5" Foreground="{DynamicResource MutedBrush}"
                            FontWeight="Bold"/>
            <!-- 曲名：放得下就静止，放不下则由 UpdateNpMarquee 匀速轮播（ClipToBounds 裁掉溢出）。
                 轮播用「原文 + 副本」首尾相接：行程只取决于文本宽度（= 文本宽 + 词间距），
                 与可见宽度无关——窗口怎么缩放都不会漏掉结尾（按「文本宽−可见宽」算行程时，
                 只要有一次没按新宽度重算，尾部就再也滚不到）。 -->
            <Grid x:Name="NpNameClip" ClipToBounds="True" Margin="0,5,0,0" SizeChanged="NpNameClip_SizeChanged">
              <!-- 用 Canvas 而非 StackPanel 承载：StackPanel 的排布宽度会被父级钳到列宽，
                   超出部分连同副本一起不渲染（实测文字到 490px 就断，而裁切区有 911px）。
                   Canvas 的子元素按 Canvas.Left 定位、不受容器宽度约束，溢出由外层 ClipToBounds 裁。 -->
              <!-- UseLayoutRounding=False：Canvas.Left 保持小数，滚动到 -dist 时副本正好落在 x=0，
                     与原文起点同一像素，回卷才真正无缝（布局取整会差半个像素）。 -->
              <Canvas x:Name="NpNameRun" HorizontalAlignment="Left" VerticalAlignment="Center"
                      UseLayoutRounding="False"
                      Height="{Binding ActualHeight, ElementName=NpNameB}">
                <local:SkiaTitle x:Name="NpNameB" Text="— NO DISC —" FontSize="17" Foreground="{DynamicResource TextBrush}"/>
                <local:SkiaTitle x:Name="NpNameBCopy" Text="" FontSize="17" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed"/>
                <Canvas.RenderTransform>
                  <TranslateTransform x:Name="NpNameShift" X="0"/>
                </Canvas.RenderTransform>
              </Canvas>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
            <Button Content="|◀" Click="BtnPrev_Click" Style="{StaticResource TxtBtn}"/>
            <Button x:Name="BtnPlayLibrary" Content="▶" Click="BtnPlay_Click" Style="{StaticResource PlayBtn}" Margin="8,0" Padding="18,9"/>
            <Button Content="▶|" Click="BtnNext_Click" Style="{StaticResource TxtBtn}"/>
          </StackPanel>
        </Grid>
      </local:SquircleBorder>

      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <local:SkiaText Text="TRACK MANAGER" FontSize="10.5"
                          Foreground="{DynamicResource PhosDimBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="Bold"/>
          <local:SkiaText x:Name="PlStats" Text="0 TRACKS"
                          FontSize="9.5" Foreground="{DynamicResource PhosDimBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0"/>
          <!-- 排序：歌名/专辑 × 正倒序 四档分开 + 导入序还原。
               Items 由代码喂字符串（显式 ComboBoxItem 进 SelectionBoxItem 在自定义模板下不渲染） -->
          <ComboBox x:Name="SortCombo" Style="{StaticResource DevCombo}" DockPanel.Dock="Right"
                    Width="150" HorizontalAlignment="Right"
                    SelectionChanged="SortCombo_SelectionChanged"/>
        </DockPanel>

        <!-- 曲目表（卡片化） -->
        <local:SquircleBorder Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="5">
          <!-- ScrollUnit=Pixel：默认 Item 按行滚动会让拖动 thumb 时偏移吸附到整行
               边界（36px 一跳）回灌给滑块——就是拖动的"阶梯感"；像素滚动拖动全程连续。
               滚轮的整行吸附由 PreviewMouseWheel 接管（滚轮 → 整行步进+对齐行边界） -->
          <DataGrid x:Name="TrackList" AutoGenerateColumns="False" CanUserAddRows="False"
                    IsReadOnly="True" SelectionUnit="FullRow" CanUserSortColumns="False"
                    MouseDoubleClick="TrackList_MouseDoubleClick" PreviewMouseWheel="TrackList_PreviewMouseWheel"
                    HeadersVisibility="Column"
                    Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    GridLinesVisibility="None"
                    FontFamily="{StaticResource UiFont}" FontSize="11.5" RowHeight="36" BorderThickness="0">
            <DataGrid.RowStyle>
              <!-- 显式极简模板：默认模板内置 IsSelected 触发器会把文字刷成系统高亮白，
                   必须整个换掉；触发器直指命名 Border 才是最终渲染层 -->
              <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                      <Border x:Name="bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <!-- ItemContainerStyle 把 CellStyle 传给单元格（TemplateBinding 编译器找不到
                             继承的 ItemContainerStyleProperty，改普通 Binding），否则单元格会用主题默认
                             样式把选中文字刷成系统高亮白 -->
                        <DataGridCellsPresenter
                            ItemContainerStyle="{Binding ItemContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                            SnapsToDevicePixels="True"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <!-- IsSelected 在后：选中行悬停时仍亮选中色 -->
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource PhosBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
              <!-- 极简单元格模板：无任何 IsSelected 视觉，让行模板的 SelBrush 透出 -->
              <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                              BorderThickness="0" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,10"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="ContentTemplate" Value="{StaticResource SkiaCaption}"/>
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <!-- 绑定必须 OneWay：只读属性走 TwoWay/OneWayToSource 会抛 InvalidOperationException（点击单元格即崩）。
                 单元格文字用 Skia：DataGridTextColumn 只会生成 TextBlock，所以列改成 TemplateColumn；
                 字号/颜色绑继承值（行上的 Foreground 选中时变磷光绿），超宽用省略号裁掉。 -->
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="TITLE" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <local:SkiaText Text="{Binding Title, Mode=OneWay}"
                                    FontSize="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}}"
                                    Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                    TextTrimming="CharacterEllipsis"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="ARTIST" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <local:SkiaText Text="{Binding Artist, Mode=OneWay}"
                                    FontSize="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}}"
                                    Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                    TextTrimming="CharacterEllipsis"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="ALBUM" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <local:SkiaText Text="{Binding Album, Mode=OneWay}"
                                    FontSize="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}}"
                                    Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                    TextTrimming="CharacterEllipsis"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="SPEC" Width="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <local:SkiaText Text="{Binding Spec, Mode=OneWay}"
                                    FontSize="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}}"
                                    Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                    TextTrimming="CharacterEllipsis"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </local:SquircleBorder>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
          <Button Content="+ Add Files" Click="BtnAdd_Click" Style="{StaticResource TxtBtn}"/>
          <Button Content="+ Add Folder" Click="BtnAddFolder_Click" Style="{StaticResource TxtBtn}" Margin="10,0,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- ══ 页脚 ══ -->
    <DockPanel Grid.Row="2" Margin="26,6,26,14">
      <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,10"/>
      <local:SkiaText Text="G# minor · NATIVE BUILD · NAudio WASAPI · T THEME · R RANGE · D DSD · N NORM · 1/2 PAGES · SPACE PLAY · F HOLD"
                     FontSize="9" Foreground="{DynamicResource MutedBrush}" Opacity="0.75"/>
    </DockPanel>
  </Grid>
  </local:SquircleBorder>
</Window>
